{
  "id": "q03",
  "pergunta": "Quais filmes têm a maior margem de lucro, entre os que possuem receita e orçamento informados?",
  "sql": "SELECT m.titulo, m.ano_lancamento, m.id_filme,\n       f.orcamento_usd, f.receita_usd,\n       ROUND((f.receita_usd - f.orcamento_usd) * 100.0 / f.receita_usd, 2) AS margem_pct\nFROM fact_movies_performance f\nJOIN dim_movies m ON m.sk_movie_id = f.sk_movie_id\nWHERE f.receita_usd IS NOT NULL\n  AND f.orcamento_usd IS NOT NULL\n  AND f.orcamento_usd >= 100000\n  AND f.receita_usd >= 100000\nORDER BY margem_pct DESC\nLIMIT 10\n",
