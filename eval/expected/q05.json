{
  "id": "q05",
  "pergunta": "Quais filmes têm a maior divergência entre a nota TMDB e a nota IMDb?",
  "sql": "SELECT m.titulo, m.ano_lancamento, m.id_filme, f.nota_tmdb, f.nota_imdb,\n       ROUND(ABS(f.nota_tmdb - f.nota_imdb), 2) AS divergencia\nFROM fact_movies_performance f\nJOIN dim_movies m ON m.sk_movie_id = f.sk_movie_id\nWHERE f.qtd_tmdb >= 100\n  AND f.nota_imdb IS NOT NULL\nORDER BY ABS(f.nota_tmdb - f.nota_imdb) DESC\nLIMIT 10\n",
  "chave": "titulo",
